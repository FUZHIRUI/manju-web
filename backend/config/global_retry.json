        "non_retryable": false
      },
      "tts_code_map_ref": "tts_30xx"
    }
  },
  "risk_rules": {
    "ark_risk": {
      "cooldown_ms": 60000,
      "max_attempts": 2,
      "codes": [
        "InputTextRiskDetection",
        "InputImageRiskDetection",
        "OutputTextRiskDetection",
        "OutputImageRiskDetection",
        "ContentSecurityDetectionError",
        "SensitiveContentDetected",
        "SensitiveContentDetected.SevereViolation",
        "SensitiveContentDetected.Violence",
        "InputTextSensitiveContentDetected",
        "InputImageSensitiveContentDetected",
        "InputVideoSensitiveContentDetected",
        "OutputTextSensitiveContentDetected",
        "OutputImageSensitiveContentDetected",
        "OutputVideoSensitiveContentDetected",
        "TooManyRequests"
      ],
      "finish_reason": ["content_filter"],
      "code_field_paths": ["error.code", "error.type", "error.Code", "error.Type"],
      "message_keywords": ["RiskDetection", "SensitiveContentDetected", "content_filter"]
    }
  },
  "tts_code_maps": {
    "tts_30xx": {
      "3000": "rate_limit",
      "3001": "timeout",
      "3002": "server_error",
      "3099": "non_retryable"
    }
  }
}
