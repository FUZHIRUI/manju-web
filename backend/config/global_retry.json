    "timeout_ms": 600000
  },
  "policies": {
    "ark_llm": {
      "max_attempts": 3,
      "error_retryable_map": {
        "network": true,
        "timeout": true,
        "rate_limit": true,
        "risk_control": true,
        "server_error": true,
        "non_retryable": false
      },
      "risk_rule_ref": "ark_risk"
    },
    "ark_vlm": {
